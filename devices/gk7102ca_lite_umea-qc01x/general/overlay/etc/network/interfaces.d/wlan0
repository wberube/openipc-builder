iface wlan0 inet dhcp
    # The vendor's own bring-up (/bak/start.sh) applies these two around
    # "ifconfig wlan0 up"; they are the only driver-visible settings their
    # working image applies that ours did not.  MTU goes on while the
    # interface is still down, so the driver sizes its TX buffers before
    # netdev_open downloads the firmware.
    pre-up echo 524288 > /proc/sys/net/core/wmem_max || true
    pre-up ip link set dev wlan0 mtu 1450 || true
    pre-up wpa_passphrase "$(fw_printenv -n wlanssid)" "$(fw_printenv -n wlanpass)" > /tmp/wpa_supplicant.conf
    pre-up sed -i 's/#psk.*/scan_ssid=1/g' /tmp/wpa_supplicant.conf
    pre-up echo 'ctrl_interface=/tmp/wpa_supplicant' >> /tmp/wpa_supplicant.conf
    pre-up wpa_supplicant -d -i wlan0 -D nl80211 -c /tmp/wpa_supplicant.conf >/dev/console 2>&1 &
    post-down killall -q wpa_supplicant
