#!/bin/sh
set_gpio() {
	[ "$2" -eq 1 ] && gpio set $1 || gpio clear $1
	sleep 1
}
if [ "$1" = "rda-generic" ]; then
	# RDA5995 (rdawfmac). The OEM holds pin 4 high for 2s then leaves it
	# LOW -- hardinfo marks WifiCtrl active-low, and the kernel's boot-time
	# GPIO map leaves that pin high (the "off" state).
	gpio set 4
	sleep 2
	gpio clear 4
	# rdawfmac is a cfg80211 driver, and it ships via the device overlay --
	# applied after the build's depmod run, so it is not in modules.dep and
	# insmod cannot pull its dependencies. Load cfg80211 first (it *is* in
	# modules.dep), or every cfg80211_*/wiphy_*/ieee80211_* symbol is unresolved.
	modprobe cfg80211
	# Bare insmod == station mode (the OEM's stop-ap.sh does exactly this;
	# only its AP path adds firmware_path=ap).
	# Let every printk reach the console from here on (the UART on this board
	# is read-only, so kernel messages are the only diagnostic channel).
	echo 8 > /proc/sys/kernel/printk
	echo "=== rda: usb bus before driver ==="
	ls /sys/bus/usb/devices/
	insmod /lib/modules/$(uname -r)/extra/rdawfmac.ko
	sleep 2
	echo "=== rda: modules ==="
	lsmod | grep -E 'rda|cfg80211|mac80211'
	echo "=== rda: interfaces ==="
	ls /sys/class/net/
	echo "=== rda: dmesg tail ==="
	dmesg | tail -40
	echo "=== rda: end ==="
	exit 0
fi
