# BeeWi BC7PW (GM8135S) — overrides the firmware's stanza.
#
# The firmware starts wpa_supplicant with "-D nl80211,wext", i.e. it tries the
# cfg80211/nl80211 path first. This vendor driver is WEXT-native -- it is built
# with -DWPA_SUPPLICANT_SUPPORT -DNATIVE_WPA_SUPPLICANT_SUPPORT, it registers a
# full WEXT handler table (rt28xx_iw_handler_def, including SIOCSIWSCAN and
# SIOCGIWSCAN), and its cfg80211 support is a shim. Over nl80211 the shim
# attaches and accepts scans but never delivers a BSS, so wpa_supplicant sits in
# SCANNING forever: no association, no DHCP lease, and nothing on the console at
# default verbosity (scan failures are MSG_DEBUG).
#
# So: drive the driver's native WEXT path. This needs
# BR2_PACKAGE_WPA_SUPPLICANT_WEXT=y in the defconfig -- with wext compiled out,
# "-D wext" is ignored and wpa_supplicant silently falls through to nl80211.
#
# -B daemonizes, and a daemonized wpa_supplicant sends its log to /dev/null, so
# -f /tmp/wpa.log is what makes its scan/association messages visible (the diag
# script dumps that file).
#
# ctrl_interface is added so wpa_cli works (S41wifi-diag uses it).
#
iface wlan0 inet dhcp
    pre-up printf 'ctrl_interface=/var/run/wpa_supplicant\nap_scan=1\n' > /tmp/wpa_supplicant.conf
    pre-up wpa_passphrase "$(fw_printenv -n wlanssid)" "$(fw_printenv -n wlanpass)" >> /tmp/wpa_supplicant.conf
    pre-up sed -i 's/#psk.*/scan_ssid=1/g' /tmp/wpa_supplicant.conf
    pre-up wpa_supplicant -B -d -f /tmp/wpa.log -i wlan0 -D wext -c /tmp/wpa_supplicant.conf
    post-down killall -q wpa_supplicant
