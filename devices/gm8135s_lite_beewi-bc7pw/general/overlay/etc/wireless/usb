#!/bin/sh
#
# BeeWi BC7PW (GM8135S) — MT7601 STA module load.
#
# Everything the driver says is invisible on the console by default: the image
# ships /etc/sysctl.conf with "kernel.printk = 3 3 1 3", so from "Running
# sysctl" onwards only errors reach ttyS0. The driver's load messages, its
# EEPROM/firmware complaints and any scan results are KERN_INFO/WARNING, which
# makes the boot log look silent whether the driver came up or not. Raise the
# console level first so the load itself is visible.
#
# The vendor blob is deliberately not shipped: it is the same source as the
# module built here, so it carries the same idle-radio-off bug, and the 5 MB
# ROOTFS partition cannot hold both (the built module is ~1.9 MB with -DDBG).
#
if [ "$1" = "mt7601sta-beewi-bc7pw" ]; then
	echo 7 4 1 7 > /proc/sys/kernel/printk
	echo "wireless: loading mt7601sta (console level raised)"
	modprobe cfg80211
	modprobe mt7601sta
	sleep 3
	echo "wireless: modprobe done, netdevs: $(ls /sys/class/net | tr '\n' ' ')"

	# RTDebugLevel defaults to RT_DEBUG_ERROR (1); 3 = RT_DEBUG_TRACE. Both of
	# these need wlan0 up: rt_ioctl_setparam refuses on a down interface
	# (-ENETDOWN), which is what "Network is down" in the logs means.
	ifconfig wlan0 up 2>/dev/null
	iwpriv wlan0 set Debug=3
	echo "wireless: Debug set (rc=$?)"

	# Belt and braces against this driver's power saving. The fix for the real
	# bug is in the source (0005-mt7601u-disable-idle-radio-off.patch); CAM also
	# covers MlmeCheckPsmChange, which would otherwise put an associated link
	# into PWR_SAVE and, on this chip, wake up deaf.
	iwpriv wlan0 set PSMode=CAM
	echo "wireless: PSMode=CAM (rc=$?)"
	iwconfig wlan0 power off 2>&1
	exit 0
fi

exit 1
