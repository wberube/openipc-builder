#!/bin/sh

on_exit() {
	mountpoint -q /proc && umount /proc
	exec /sbin/init "$*"
}

trap on_exit EXIT

# Give /etc a tmpfs of its own, seeded from the read-only copy, for the case
# where the root cannot be made writable. Without it the camera boots but no
# program can write its configuration: fw_setenv cannot cache its config, and
# anything that stores state in /etc fails, which is what this board did for
# as long as the union was read-only. Cheap and tolerant: a camera with a
# writable /etc on RAM is still a camera, and it says so on the console.
etc_on_tmpfs() {
	[ -d /mnt ] || return 0
	mount -t tmpfs tmpfs /mnt 2>/dev/null || return 0
	cp -a /etc/. /mnt/ 2>/dev/null
	if mount -o bind /mnt /etc 2>/dev/null; then
		return 0
	fi
	umount /mnt
	return 0
}

# True when the flash answers at the midpoint of the size the kernel believes it
# has with the same bytes it holds at offset zero -- that is, the chip is half
# that size and every address past its real end wraps back to the start.
#
# A kernel that sizes the chip wrongly puts rootfs_data partly or wholly on that
# mirror. jffs2 then cannot mount it, and erasing it to format it erases the
# bootloader, the environment, the kernel and the rootfs underneath the running
# system: the camera works for this one boot and never again. The SigmaStar
# kernels did this with any NOR part missing from their ID table, taking it for
# 16 MB (OpenIPC/firmware#1938, #1998).
#
# Only reads. Partition positions come from sysfs, which the kernel fills in
# for every partition. Where it does not, a partition is taken to follow the
# one before it, as every OpenIPC layout has it. If anything here cannot be
# worked out the answer is "no", which is the behaviour this replaced.
flash_aliased() {
	sysfs=false
	if [ ! -d /sys/class/mtd ] && mount -t sysfs sysfs /sys 2>/dev/null; then
		sysfs=true
	fi
	# "name offset size", one line per partition, in bytes.
	geometry=$(awk 'NR > 1 {sub(":", "", $1); print $1, $2}' /proc/mtd | {
		next=0
		while read -r dev size; do
			size=$((0x$size))
			offset=$(cat /sys/class/mtd/$dev/offset 2>/dev/null)
			[ -n "$offset" ] || offset=$next
			echo "$dev $offset $size"
			next=$((offset + size))
		done
	})
	$sysfs && umount /sys

	total=0
	head_dev=
	while read -r dev offset size; do
		[ -n "$size" ] || continue
		[ $((offset + size)) -gt $total ] && total=$((offset + size))
		[ "$offset" -eq 0 ] && head_dev=$dev
	done <<EOF
$geometry
EOF
	half=$((total / 2))
	[ -n "$head_dev" ] && [ $half -gt 0 ] && [ $((half % 65536)) -eq 0 ] || return 1

	while read -r dev offset size; do
		[ -n "$size" ] || continue
		if [ $half -ge $offset ] && [ $half -lt $((offset + size)) ]; then
			head=$(dd if=/dev/$head_dev bs=65536 count=1 2>/dev/null | md5sum)
			mirror=$(dd if=/dev/$dev bs=65536 skip=$(((half - offset) / 65536)) count=1 2>/dev/null | md5sum)
			# A read that failed and a block never written match anything
			# like them, so neither can prove a mirror.
			[ "$head" != "$(printf '' | md5sum)" ] || return 1
			[ "$head" != "$(dd if=/dev/zero bs=65536 count=1 2>/dev/null | tr '\000' '\377' | md5sum)" ] || return 1
			[ "$head" = "$mirror" ]
			return
		fi
	done <<EOF
$geometry
EOF
	return 1
}

mount -t proc proc /proc || exit 1
grep -q overlay /proc/filesystems || exit 1

is_flash_root=true
is_nfs_root=false
# Anchor these to the root= value. A bare "ram"/"mmcblk"/"nfs" matched the whole
# command line, so any unrelated token carrying those letters -- e.g. the
# "ramoops" crash-log parameters -- was mistaken for a ramdisk/SD/NFS root, the
# flash overlay was never mounted, and the camera booted read-only and unclaimed.
grep -qE 'root=[^ ]*(nfs|mmcblk|ram)' /proc/cmdline && is_flash_root=false
grep -qE 'root=[^ ]*nfs' /proc/cmdline && is_nfs_root=true

if $is_flash_root; then
	if grep -q ubifs /proc/cmdline; then
		mount -t ubifs ubi0:rootfs_data /overlay
	else
		# The writable data partition is named rootfs_data on an OpenIPC
		# flash map, and that is the only name this script has ever looked
		# for. This board's map is not an OpenIPC one: spi_flash.c builds it
		# from the sys_header the vendor's first-stage loader left at offset
		# 0, and the fifth of those partitions is named USER (mtd3,
		# 0x880000-0x1000000). Accept either name; with neither, the lookups
		# below used to expand to nothing and this script ran `mount -t jffs2
		# /dev/ /overlay` and `flash_eraseall -j /dev/` before falling back
		# to tmpfs, which is how the board ended up with a volatile overlay.
		for name in rootfs_data USER; do
			mtdchrdev=$(grep "\"$name\"" /proc/mtd | cut -d: -f1)
			[ -n "$mtdchrdev" ] && break
		done
		mtdblkdev=$(echo "$mtdchrdev" | sed 's/mtd/mtdblock/')

		if [ -z "$mtdchrdev" ]; then
			echo "No rootfs_data or USER partition in the flash map, overlay stays in RAM."
			mount -t tmpfs tmpfs /overlay || exit 1
		# Before anything touches rootfs_data: mounting jffs2 on a mirror is
		# already a write, since the scan queues every block it cannot parse
		# for erasure.
		elif ! grep -q 'nand' /proc/cmdline && flash_aliased; then
			echo "Flash is smaller than the kernel thinks: leaving it alone, settings will not persist."
			if ! mount -t tmpfs tmpfs /overlay; then
				echo "Cannot mount overlay."
				exit 1
			fi
		elif ! mount -t jffs2 /dev/$mtdblkdev /overlay || dmesg | grep -q "jffs2.*: Magic bitmask.*not found"; then
			mountpoint -q /overlay && umount /overlay
			echo "Formatting flash..."
			grep -q 'nand' /proc/cmdline || jffs2="-j"
			flash_eraseall $jffs2 /dev/$mtdchrdev
			if ! mount -t jffs2 /dev/$mtdblkdev /overlay && ! mount -t tmpfs tmpfs /overlay; then
				echo "Cannot mount overlay."
				exit 1
			fi
		fi
	fi
elif $is_nfs_root && grep -q ' ro ' /proc/cmdline; then
	TMPFS_SIZE='@TMPFS_SIZE@'
	TMPFS_SIZE="${TMPFS_SIZE:-16M}"
	if ! mount -t tmpfs -o mode=0755,size=${TMPFS_SIZE} tmpfs /overlay; then
		echo "Cannot mount tmpfs overlay."
		exit 1
	fi
fi

if $is_flash_root || $is_nfs_root; then
	# The union is mounted read-write, and upstream mounts it read-only. On
	# this board that option is the whole problem: the writes are refused by
	# the overlay rather than by squashfs, so they fail with EOPNOTSUPP
	# instead of EROFS, and it surfaces as
	#
	#	overlayfs: ERROR - failed to whiteout 'gmlib.cfg'
	#	rm: can't remove '/etc/sensors/gmlib.cfg': Operation not supported
	#
	# and as fw_printenv being unable to cache its config. Read-write needs
	# the upper to hold the metadata overlayfs uses, and the upper is a real
	# filesystem now rather than a tmpfs: a whiteout here is a symlink to
	# "(overlay-whiteout)" carrying trusted.overlay.whiteout
	# (fs/overlayfs/dir.c:17-60), so it needs no device nodes -- which jffs2
	# cannot create -- and fs/jffs2/xattr.c registers the trusted handler with
	# CONFIG_JFFS2_FS_XATTR=y in this kernel. noatime keeps reads from
	# dirtying the flash.
	if grep -q overlayfs /proc/filesystems; then
		union=overlayfs
		opts="lowerdir=/,upperdir=/overlay"
	else
		union=overlay
		opts="lowerdir=/,upperdir=/overlay/root,workdir=/overlay/work"
		mkdir -p /overlay/root /overlay/work
	fi

	if mount -t $union $union -o $opts,noatime,rw /mnt; then
		echo "init: root is read-write ($union on /overlay)"
	elif mount -t $union $union -o $opts,noatime,ro /mnt; then
		echo "init: the union only mounts read-only, /etc needs its own filesystem"
		union_ro=true
	else
		echo "init: no way to mount the overlay, booting the read-only root as is"
		etc_on_tmpfs
		exit 0
	fi

	pivot_root /mnt /mnt/rom
	mount -o noatime,move /rom/proc /proc
	mount -o noatime,move /rom/dev /dev
	mount -o noatime,move /rom/overlay /overlay

	if [ -n "$union_ro" ]; then
		etc_on_tmpfs
	fi
fi
